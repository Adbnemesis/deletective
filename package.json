{
  "name": "deletective",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "dev:rooms": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --ip 127.0.0.1 --port 8787",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:seo": "node scripts/audit-seo.mjs",
    "deploy:check": "npm run build && WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --env production",
    "deploy:staging": "npm run build && WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --env staging",
    "deploy:production": "node scripts/check-launch-config.mjs && npm run build && WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --env production",
    "test:integration": "node tests/integration/realtime.mjs",
    "test:recovery": "node tests/integration/recovery.mjs",
    "test:load": "node tests/integration/load.mjs"
  },
  "dependencies": {
    "astro": "7.4.3",
    "@astrojs/react": "7.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261028.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
