---
import '../styles/global.css';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/space-grotesk';
interface Props { title?: string; description?: string; privatePage?: boolean; }
const { title = 'Deletective — A free online party game with friends', description = 'Read the reactions. Invent the deleted message. Make your friends lose it. A free browser game for 2–10 players, with a daily solo challenge.', privatePage = false } = Astro.props;
const raw = import.meta.env.PUBLIC_SITE_URL || '';
let origin = '';
try { const u = new URL(raw); if (u.protocol === 'https:' || u.protocol === 'http:') origin = u.origin; } catch {}
const provisional = !origin || /localhost|127\.0\.0\.1/.test(origin);
const canonical = origin ? new URL(Astro.url.pathname, origin).href : undefined;
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Deletective', description, applicationCategory: 'GameApplication', operatingSystem: 'Web browser', browserRequirements: 'JavaScript and WebSocket support', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, ...(origin ? { url: origin } : {}) };
const path = Astro.url.pathname;
const analyticsToken = !privatePage && /^[a-f0-9]{32}$/i.test(import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN || '') ? import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f8f7f2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={privatePage || provisional ? 'noindex, nofollow' : 'index, follow'} />
    {canonical && !privatePage && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Deletective" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && !privatePage && <meta property="og:url" content={canonical} />}
    {origin && <meta property="og:image" content={`${origin}/social-card.png`} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="What did they delete?! Invent the missing message in a fictional group chat." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!privatePage && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    {analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token: analyticsToken, spa: false})}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a href="/" class="wordmark" aria-label="Deletective home">
        <svg class="brand-icon" width="39" height="39" viewBox="0 0 44 44" aria-hidden="true"><path d="M6 6h32v26H24l-10 7v-7H6z" fill="#d8f36a" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M13 15l7 2m11-2-7 2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="17" cy="22" r="2"/><circle cx="27" cy="22" r="2"/></svg>
        <span>deletective<span class="wordmark-dot">.</span></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/how-to-play" aria-current={path === '/how-to-play' ? 'page' : undefined}>How to play</a>
        <a href="/daily" aria-current={path === '/daily' ? 'page' : undefined}>Daily challenge <span class="little-sun" aria-hidden="true">✳</span></a>
        <a href="/play" class="button button-small dark">Let’s play <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-logo" href="/">deletective.</a><p>Some messages are better left undeleted.</p><span class="micro">Made for your favorite weird people.</span></div>
      <nav aria-label="Game modes"><a href="/2-player">Two players</a><a href="/couples">Date night</a><a href="/party">Party mode</a><a href="/daily">Daily challenge</a></nav>
      <nav aria-label="About and policies"><a href="/about">About the game</a><a href="/faq">Questions?</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav>
      <div class="footer-bottom"><span>© {new Date().getUTCFullYear()} Deletective · Provisional brand</span><span>Free to play. No account. Just friends.</span></div>
    </footer>
  </body>
</html>
